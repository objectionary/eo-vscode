{
  "autoClosingPairs": [
    {
      "close": "]",
      "open": "["
    },
    {
      "close": ")",
      "open": "("
    },
    {
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ],
      "open": "\""
    }
  ],
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "comments": {
    "lineComment": "#"
  },
  "indentationRules": {
    "decreaseIndentPattern": "^\\s+$",
    "increaseIndentPattern": "(^\\s*\\[.*\\]\\s*>\\s*\\S+\\s*$)|(>\\s*@?\\s*$)|(>\\s*\\S+\\s*$)"
  },
  "surroundingPairs": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ]
}
